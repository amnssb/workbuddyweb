# ==============================================================================
# WorkBuddy 融合版环境变量配置模板
# 复制本文件为 .env 即可生效：cp .env.example .env
# ==============================================================================

# 外部访问与服务映射端口 (默认: 7864)
PORT=7864

# 管理员首次初始化密码 (推荐修改。若留空，首启将自动随机生成强密码并在容器日志中打印)
# WB_ADMIN_PASSWORD=YourStrongPasswordHere

# 信任反向代理（如 Nginx / Caddy / 1Panel / Traefik）传入的 X-Real-IP / X-Forwarded-For 真实客户端 IP
WB_TRUST_PROXY=1

# 是否对外暴露 /docs 与 /openapi.json 接口文档 (生产环境建议 0，调试排错可设为 1)
WB_ENABLE_DOCS=0

# 会话登录有效期（天数，默认 1 天，滑动续期）
WB_SESSION_DAYS=1

# 时区配置
TZ=Asia/Shanghai

# ------------------------------------------------------------------------------
# 网关与审计配置
# ------------------------------------------------------------------------------
# 网关请求体上限（MB），默认 32MB，足够容纳常见长上下文与附件
# WB_GATEWAY_MAX_BODY_MB=32

# 单 IP 每分钟最大请求数，0 表示不限制
# WB_GATEWAY_RATE_PER_MIN=120

# 全量访问日志记录，0=只记录异常访问，1=记录所有访问（调试用）
# WB_AUDIT_ALL_ACCESS=0

# 上游请求超时（秒），长推理场景可调大
# WB_UPSTREAM_TIMEOUT=120

# ------------------------------------------------------------------------------
# 镜像构建加速参数（仅在需要重新 build 镜像时使用，国内机器推荐开启）
# ------------------------------------------------------------------------------
# GOPROXY=https://goproxy.cn,direct
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# DEBIAN_MIRROR=mirrors.aliyun.com
